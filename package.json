{
  "name": "accessory-designer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup:desktop": "node scripts/setup-desktop.mjs",
    "desktop": "node scripts/desktop-launcher.mjs",
    "test:desktop": "node --test --test-concurrency=1 scripts/desktop-build.test.mjs scripts/desktop-launcher.test.mjs scripts/desktop-startup.test.mjs",
    "parts:audit-calibration": "node scripts/audit-calibration.mjs",
    "db:prepare": "node scripts/prepare-database.mjs",
    "dev": "node scripts/local-next.mjs dev",
    "build": "next build",
    "start": "node scripts/local-next.mjs start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "workspace:restore": "node scripts/restore-local-workspace.mjs",
    "parts:probe-official-calibration": "node scripts/probe-official-calibration.mjs",
    "parts:map-official": "node scripts/map-official-parts.mjs",
    "parts:register-mapped": "node scripts/map-official-parts.mjs --register",
    "parts:plan-images": "node scripts/inspect-official-images.mjs",
    "parts:inspect-images": "node scripts/inspect-official-images.mjs --run",
    "parts:ocr-images": "node scripts/ocr-official-images.mjs",
    "parts:plan-nominal": "node scripts/register-nominal-parts.mjs",
    "parts:prepare-teardrop": "node scripts/prepare-reviewed-teardrop.mjs",
    "parts:register-nominal": "node scripts/register-nominal-parts.mjs --register",
    "parts:plan-batches": "node scripts/plan-calibration-batches.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@supabase/supabase-js": "^2.117.2",
    "cheerio": "^1.2.0",
    "ipaddr.js": "^2.5.0",
    "konva": "^10.7.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-konva": "^19.3.0",
    "tesseract.js": "7.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
